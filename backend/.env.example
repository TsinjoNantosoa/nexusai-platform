NEXUSAI_DATABASE_URL=postgresql+psycopg://nexusai:nexusai@localhost:55432/nexusai
NEXUSAI_ENVIRONMENT=development
NEXUSAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXUSAI_TRUSTED_HOSTS=localhost,127.0.0.1
NEXUSAI_SESSION_COOKIE_NAME=nexusai_session
NEXUSAI_CSRF_COOKIE_NAME=nexusai_csrf
NEXUSAI_SESSION_TTL_SECONDS=28800
NEXUSAI_COOKIE_SECURE=false
NEXUSAI_COOKIE_SAMESITE=lax
NEXUSAI_AUTH_RATE_LIMIT=10
NEXUSAI_AUTH_RATE_WINDOW_SECONDS=60
